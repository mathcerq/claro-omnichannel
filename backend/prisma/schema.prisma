generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  phone        String?
  passwordHash String
  role         String   @default("CLIENT")
  totpSecret   String?
  totpEnabled  Boolean  @default(false)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  clientProtocols   Protocol[]        @relation("ClientProtocols")
  agentProtocols    Protocol[]        @relation("AgentProtocols")
  sentMessages      Message[]
  twoFactorSessions TwoFactorSession[]
  auditLogs         AuditLog[]
  channelIdentities ChannelIdentity[]
  channelLinkCodes  ChannelLinkCode[]
}

model Protocol {
  id             String    @id @default(uuid())
  protocolNumber String    @unique
  title          String
  description    String?
  status         String    @default("OPEN")
  priority       String    @default("MEDIUM")
  currentChannel String    @default("WEBCHAT")

  clientId String
  client   User   @relation("ClientProtocols", fields: [clientId], references: [id])

  agentId String?
  agent   User?   @relation("AgentProtocols", fields: [agentId], references: [id])

  messages  Message[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  closedAt  DateTime?
}

model Message {
  id         String   @id @default(uuid())
  content    String
  channel    String
  senderRole String
  isRead     Boolean  @default(false)
  metadata   String?
  createdAt  DateTime @default(now())

  /// Id da mensagem no canal de origem (ex.: "<chatId>:<messageId>" no Telegram).
  /// Garante idempotência: a mesma mensagem externa nunca entra duas vezes na timeline.
  externalId     String?
  /// Entrega em canal externo (mensagens de atendente): SENT | FAILED | SIMULATED
  deliveryStatus String?

  protocolId String
  protocol   Protocol @relation(fields: [protocolId], references: [id])

  senderId String
  sender   User   @relation(fields: [senderId], references: [id])

  @@unique([channel, externalId])
  @@index([protocolId, createdAt])
}

/// Vínculo entre um usuário CLIENT e sua identidade em um canal externo
/// (ex.: chat do Telegram). Genérico: novos canais reutilizam a mesma tabela.
model ChannelIdentity {
  id         String @id @default(uuid())
  channel    String
  /// Identificador no canal (no Telegram: chat id da conversa privada)
  externalId String

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Protocolo em que as próximas mensagens deste canal serão registradas
  activeProtocolId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([channel, externalId])
  @@unique([channel, userId])
}

/// Código de vínculo de uso único, gerado pelo cliente logado no WebChat.
/// Apenas o hash SHA-256 é persistido.
model ChannelLinkCode {
  id        String    @id @default(uuid())
  channel   String
  codeHash  String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model TwoFactorSession {
  id        String   @id @default(uuid())
  tokenHash String
  expiresAt DateTime
  used      Boolean  @default(false)
  ipAddress String?
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id])
}

model AuditLog {
  id        String   @id @default(uuid())
  action    String
  resource  String
  details   String?
  ipAddress String?
  createdAt DateTime @default(now())

  userId String?
  user   User?   @relation(fields: [userId], references: [id])
}
