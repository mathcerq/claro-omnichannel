# Copie para backend/.env e preencha. NUNCA versione o .env.

# Banco SQLite local (caminho relativo a prisma/schema.prisma)
DATABASE_URL="file:./dev.db"
PORT=3000
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Segredos JWT — gere valores aleatórios longos e distintos, por exemplo:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Chave AES usada para cifrar o segredo TOTP (2FA) no banco
TOTP_ENCRYPTION_KEY=

# Canal Telegram (real). Token obtido com o @BotFather.
# Vazio = canal Telegram desligado (o resto do sistema funciona normalmente).
TELEGRAM_BOT_TOKEN=
# Opcional: base da Bot API. Só altere para testes automatizados (servidor fake).
# TELEGRAM_API_BASE=https://api.telegram.org
# URL da Central do Cliente exibida nas instruções do bot
CLIENT_APP_URL=http://localhost:5174

# Assistente virtual (IA de atendimento nível 1)
#   ollama = IA local e gratuita (https://ollama.com), com reserva automática por regras
#   rules  = só regras por palavras-chave (sem IA generativa)
#   off    = desligada (todo protocolo vai direto para atendentes)
ASSISTANT_ENGINE=ollama
OLLAMA_URL=http://localhost:11434
# Modelo testado: qwen3:4b (≈2,5 GB; cabe em GPUs de 4–6 GB). Baixe com: ollama pull qwen3:4b
OLLAMA_MODEL=qwen3:4b
# Raciocínio ligado: respostas mais lentas (~15–30s), porém corretas com ferramentas
OLLAMA_THINK=true
# Tempo que o modelo fica carregado na GPU sem uso (evita a 1ª resposta lenta)
OLLAMA_KEEP_ALIVE=4h
